{
  "$schema": "https://developer.joomla.org/schemas/json-schema/web_assets.json",
  "name": "tpl_narrow",
  "version": "1.0.0",
  "description": "Template Narrow Layout para Joomla 6",
  "license": "GPL-2.0-or-later",
  "assets": [
    {
      "name": "template.narrow.style",
      "type": "style",
      "uri": "templates/tpl_narrow/css/template.css",
      "version": "1.0.0",
      "dependencies": [],
      "attributes": {
        "media": "all"
      }
    },
    {
      "name": "template.narrow.bootstrap.style",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css",
      "version": "5.3.3",
      "dependencies": [],
      "attributes": {
        "media": "screen",
        "rel": "stylesheet"
      }
    },
    {
      "name": "template.narrow.fonts.style",
      "type": "style",
      "uri": "https://cdn.jsdelivr.net/npm/@fontsource/inter@5.1.0/index.css",
      "version": "5.1.0",
      "dependencies": [],
      "attributes": {
        "media": "screen"
      }
    },
    {
      "name": "template.narrow.script",
      "type": "script",
      "uri": "templates/tpl_narrow/js/template.js",
      "version": "1.0.0",
      "dependencies": ["bootstrap.bundle"],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "bootstrap.bundle",
      "type": "script",
      "uri": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js",
      "version": "5.3.3",
      "dependencies": [],
      "attributes": {
        "defer": true
      }
    },
    {
      "name": "template.narrow.carousel",
      "type": "script",
      "uri": "templates/tpl_narrow/js/carousel.js",
      "version": "1.0.0",
      "dependencies": ["bootstrap.bundle"],
      "attributes": {
        "defer": true
      }
    }
  ]
}
